# ──────────────────────────────────────────────
#  Google Apps Script — .gitignore
# ──────────────────────────────────────────────

# Node / tooling (type stubs, linters, formatters)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-debug.log*

# clasp (Google Apps Script CLI) credentials — NEVER commit these
.clasp.json
creds.json
credentials.json
token.json
service-account*.json

# Environment / secrets
.env
.env.*
!.env.example

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Build / dist output (if clasp push is ever used)
dist/
build/

# Logs
*.log
logs/

# Local workspace metadata (not committed to git)
tasks/

# Temporary files
*.tmp
*.bak
~$*
